{
  "name": "whatsapp-tauri",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:backend": "go -C src-go build -o backend && go -C src-go build -o backend-x86_64-unknown-linux-gnu",
    "dev": "NEXT_DIST_DIR=.next-dev next dev",
    "dev:tauri": "NEXT_DIST_DIR=.next-tauri next dev -p 1420",
    "build": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next build",
    "start": "next start",
    "lint": "next lint",
    "tauri": "tauri"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.8",
    "dayjs": "^1.11.13",
    "next": "15.3.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-virtuoso": "^4.18.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/cli": "^2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.3.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
